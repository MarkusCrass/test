{
  "name": "knights-last-standing",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "KNIGHTS: LAST STANDING — Stylized Low-Poly 3D Third-Person Arena Fighter (Free-for-All)",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "build": "tsc && vite build",
    "start": "tsx server/prodServer.ts",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "test": "vitest run",
    "build:yandex": "tsc && vite build --mode yandex",
    "package:yandex": "npm run build:yandex && rm -f knights-yandex-games.zip && cd dist-yandex && zip -rq ../knights-yandex-games.zip . -x .htaccess deploy.php \"api/*\""
  },
  "dependencies": {
    "@fontsource/cinzel": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/philosopher": "^5.3.0",
    "three": "^0.170.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/jsdom": "^21.1.7",
    "@types/node": "^26.6.5",
    "@types/three": "^0.170.0",
    "@types/ws": "^8.18.2",
    "jsdom": "^26.1.0",
    "tsx": "^4.23.15",
    "typescript": "^5.6.3",
    "vite": "^6.0.5",
    "vitest": "^2.1.8"
  }
}
